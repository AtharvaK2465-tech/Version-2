# Copy this file to .env and fill in real values.
# The app runs in MOCK MODE automatically if any of these are missing —
# you can develop and demo the full pipeline before you have real keys.

SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
GEMINI_API_KEY=

# Optional — only needed for the Alert Agent's SMS path
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
